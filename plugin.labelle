// labelle-ios package manifest (manifest v2, labelle-cli provider contract):
// the `ios` target provider and the `ios` command namespace (RFC
// labelle-cli#471 I1, I6).
//
// `.name = "ios"` because the assembler derives a plugin's module alias as
// `labelle_<name>`, and this package's one module is `labelle_ios` (the name
// its `build.zig.zon` declares). The `.plugins` entry, the registry package
// and `.provider_config .package` must all use this name.
//
// The `ios` namespace is the provider's since labelle-cli 4.0 (I5 removed the
// core `labelle ios`). Commands (`labelle ios <cmd>`) act on the output of
// `labelle build --platform=ios`, whose hooks this package supplies:
//   - `device` before `build`: for `destination: "device"`, asks the core
//     build for `-Ddevice=true` through `build_options` in `env_file`
//     (contract 1.6.0; older wires refuse a device build);
//   - `app` after `build`: wraps the core build's executable into
//     `zig-out/ios/<AppName>.app` (Info.plist, launch screen, icon), ad-hoc
//     signed for the simulator or signed with `signing.{identity,profile}`
//     for a device;
//   - `launch` replacing `run`: installs that app and runs it in the
//     foreground on a simulator (`simctl`) or a device (`devicectl`),
//     blocking until the app exits;
//   - `bundle` replacing `bundle`: the simulator `.app` zipped, or the
//     device `.ipa`.
//
// Every command and hook runs the one host tool `bin/labelle-ios`
// (`tools/main.zig`, built by `zig build install-provider`).
// `command_contract` admits exactly the wire versions its strict decoder
// (`tools/contract.zig`, contract 1.6.0) and the tool handle from 1.3.0 on:
// 1.3 (`env_file`), 1.4 (`final_step`, decoded and unused), 1.5
// (`run.outcome_file`, to report a `--timeout` stop) and 1.6 (`build_options`,
// device builds). A 1.7 minor is not admitted until the decoder learns it.
.{
    .name = "ios",
    .manifest_version = 2,
    .command_contract = ">=1.3.0 <1.7.0",
    .namespace = "ios",
    .targets = .{"ios"},
    .commands = .{
        .{ .name = "doctor", .build_step = "install-provider", .executable = "bin/labelle-ios", .help = "Check Xcode, its license, the iOS SDKs and simulator runtimes, the backend and device signing (--json, --fix)", .needs_project = false },
        .{ .name = "devices", .build_step = "install-provider", .executable = "bin/labelle-ios", .help = "List iOS simulators and connected devices with the id --device takes", .needs_project = false },
        .{ .name = "xcode", .build_step = "install-provider", .executable = "bin/labelle-ios", .help = "Write an Xcode project around the built app (--output=DIR, default ios-xcode/)", .needs_project = true },
        .{ .name = "run", .build_step = "install-provider", .executable = "bin/labelle-ios", .help = "Install and run the built app on a simulator or device (--device=<udid|name>)", .needs_project = true },
    },
    .hooks = .{
        .{ .id = "device", .step = .build, .target = "ios", .when = .before, .build_step = "install-provider", .executable = "bin/labelle-ios" },
        .{ .id = "app", .step = .build, .target = "ios", .when = .after, .build_step = "install-provider", .executable = "bin/labelle-ios" },
        .{ .id = "launch", .step = .run, .target = "ios", .when = .replace, .build_step = "install-provider", .executable = "bin/labelle-ios" },
        .{ .id = "bundle", .step = .bundle, .target = "ios", .when = .replace, .build_step = "install-provider", .executable = "bin/labelle-ios" },
    },
}
